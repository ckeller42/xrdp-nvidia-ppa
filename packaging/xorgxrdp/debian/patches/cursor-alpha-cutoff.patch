From 5ad6babbab18c861b3bc1eedc490bdbdb88c8de5 Mon Sep 17 00:00:00 2001
From: Christoph Keller <christoph.keller@gmx.net>
Date: Fri, 2 Oct 2026 14:56:11 +0200
Subject: [PATCH] cursor: optional alpha cutoff for clients that ignore cursor
 alpha

Clients that ignore the alpha channel of 32bpp pointers (e.g. Jump
Desktop) draw the semi-transparent drop shadow of themes like Yaru or
Adwaita as an opaque dark outline around the pointer.

Add an opt-in environment variable XORGXRDP_CURSOR_ALPHA_CUTOFF (1..256,
e.g. set in sesman.ini [SessionVariables]): cursor pixels with alpha
below the cutoff are sent fully transparent (and, with the previous
commit, marked in the AND mask). Unset or invalid means off, so the
default behaviour is unchanged; when enabled the soft shadow is dropped
for all clients of that session.

Verified with the pointer dump test (Yaru, 32x32): unset -> 0 box pixels,
174 pixels with 0 < alpha < 128 unchanged; XORGXRDP_CURSOR_ALPHA_CUTOFF=128
-> 0 box pixels, 0 such pixels.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VLJpmVyG6ghcutrcFH3F8v
---
 module/rdpCursor.c | 34 ++++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/module/rdpCursor.c b/module/rdpCursor.c
index cc84745..0054d82 100644
--- a/module/rdpCursor.c
+++ b/module/rdpCursor.c
@@ -220,6 +220,34 @@ set_pixel_safe(uint8_t *data, int x, int y, int width, int height, int bpp,
     }
 }
 
+/******************************************************************************/
+/* Optional: treat cursor pixels with alpha below XORGXRDP_CURSOR_ALPHA_CUTOFF
+ * (1..256, unset = off) as fully transparent. For clients that ignore the
+ * alpha channel and would draw soft shadows as an opaque dark outline. */
+static int
+get_cursor_alpha_cutoff(void)
+{
+    static int cutoff = -1;
+    const char *env;
+
+    if (cutoff < 0)
+    {
+        cutoff = 0;
+        env = getenv("XORGXRDP_CURSOR_ALPHA_CUTOFF");
+        if (env != NULL)
+        {
+            cutoff = atoi(env);
+            if ((cutoff < 0) || (cutoff > 256))
+            {
+                cutoff = 0;
+            }
+            LOG(LOG_LEVEL_INFO, "get_cursor_alpha_cutoff: "
+                "XORGXRDP_CURSOR_ALPHA_CUTOFF %d", cutoff);
+        }
+    }
+    return cutoff;
+}
+
 /******************************************************************************/
 static void
 rdpSpriteSetCursorCon(rdpClientCon *clientCon,
@@ -248,6 +276,7 @@ rdpSpriteSetCursorCon(rdpClientCon *clientCon,
     int can_do_new;
     int can_do_large;
     int cursor_id;
+    int alpha_cutoff;
 
     LOG(LOG_LEVEL_TRACE, "rdpSpriteSetCursorCon:");
     if (clientCon->suppress_output)
@@ -313,6 +342,7 @@ rdpSpriteSetCursorCon(rdpClientCon *clientCon,
             xhot = pCurs->bits->xhot;
             yhot = pCurs->bits->yhot;
             data = (uint8_t *)(pCurs->bits->argb);
+            alpha_cutoff = get_cursor_alpha_cutoff();
             memset(cur_data, 0, 96 * 96 * 4);
             memset(cur_mask, 0, 96 * 96 / 8);
             for (jndex = 0; jndex < sending_height; jndex++)
@@ -322,6 +352,10 @@ rdpSpriteSetCursorCon(rdpClientCon *clientCon,
                     pixel = get_pixel_safe(data, index, jndex,
                                            paddedRowBytes / 4,
                                            server_height, 32);
+                    if (((pixel >> 24) & 0xff) < alpha_cutoff)
+                    {
+                        pixel = 0;
+                    }
                     /* fully transparent: mark in the AND mask too, and
                      * clear the colour (XOR) bytes, for clients that
                      * ignore the alpha channel */
