# xrdp-gnome-session: remote desktop server defaults: no screen lock, no blanking, no suspend
[org/gnome/desktop/screensaver]
lock-enabled=false
idle-activation-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/lockdown]
disable-lock-screen=true

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
power-button-action='nothing'
idle-dim=false

# remote desktop fluency: no animations -> actions appear instantly, fewer frames to encode
[org/gnome/desktop/interface]
enable-animations=false

# Ubuntu dock favorites: Ubuntu's defaults point at snaps (firefox_firefox, snap-store, ...) that don't exist on Pop -> use the debs
[org/gnome/shell]
favorite-apps=['firefox.desktop', 'thunderbird.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Rhythmbox3.desktop', 'libreoffice-writer.desktop', 'org.gnome.Software.desktop', 'yelp.desktop']

# dock: only mounted volumes (hide the server's internal disks)
[org/gnome/shell/extensions/dash-to-dock]
show-mounts-only-mounted=true

# users can't install system updates (admin does, via apt) -> no per-user background downloads
[org/gnome/software]
download-updates=false
download-updates-notify=false
