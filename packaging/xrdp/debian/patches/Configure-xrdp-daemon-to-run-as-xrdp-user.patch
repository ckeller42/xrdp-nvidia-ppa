From: Arnaud Rebillout <arnaudr@kali.org>
Date: Fri, 3 Apr 2026 11:37:37 +0700
Subject: Configure xrdp daemon to run as xrdp user

Forwarded: not-needed, Debian-specific
---
 sesman/sesman.ini.in | 2 +-
 xrdp/xrdp.ini.in     | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

Index: xrdp/sesman/sesman.ini.in
===================================================================
--- xrdp.orig/sesman/sesman.ini.in
+++ xrdp/sesman/sesman.ini.in
@@ -68,8 +68,7 @@ RestrictInboundClipboard=none
 ;    sockets or chansrv sockets in the local sockets dir, set this to
 ;    the runtime_group in xrdp.ini. If you do not do this, xrdp will not
 ;    be able to connect to your sessions.
-SessionSockdirGroup=root
-#SessionSockdirGroup=xrdp
+SessionSockdirGroup=xrdp
 
 
 [Sessions]
Index: xrdp/xrdp/xrdp.ini.in
===================================================================
--- xrdp.orig/xrdp/xrdp.ini.in
+++ xrdp/xrdp/xrdp.ini.in
@@ -39,8 +39,8 @@ port=3389
 ; Unprivileged User name and group to run the xrdp daemon.
 ; It is HIGHLY RECOMMENDED you set these values. See the xrdp.ini(5)
 ; manpage for more information on setting and checking these.
-#runtime_user=xrdp
-#runtime_group=xrdp
+runtime_user=xrdp
+runtime_group=xrdp
 
 ; regulate if the listening socket use socket option tcp_nodelay
 ; no buffering will be performed in the TCP stack
