#!/bin/sh

set -eu

# Our postinst adds xrdp to ssl-cert (snakeoil key); without it the script gives us this error line:
# [  NG  ] /etc/xrdp/key.pem is not readable by xrdp:xrdp
if ! id -nG xrdp | grep -qw ssl-cert; then
    echo "postinst did not add xrdp to ssl-cert" >&2
    exit 1
fi

echo "Checking if xrdp is properly configured to run in non-privileged mode..."
echo "$ /usr/share/xrdp/xrdp-chkpriv"
/usr/share/xrdp/xrdp-chkpriv | tee $AUTOPKGTEST_TMP/xrdp.out

# runtime_user=xrdp needs SessionSockdirGroup=xrdp (sesman.ini), so this advisory WARN is expected
if grep -v 'consider setting SessionSockdirGroup = root' $AUTOPKGTEST_TMP/xrdp.out \
    | grep -q -E '\[ *(NG|WARN) *\]'; then
    echo "xrdp-chkpriv FAILED!" >&2
    exit 1
fi
